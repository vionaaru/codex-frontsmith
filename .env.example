# Режим доставки: resend — отправка, dry-run — проверка, disabled — отключено
CONTACT_DELIVERY_MODE=resend
# Адрес владельца для получения заявок
CONTACT_TO_EMAIL=projects@acme.com
# Отправитель с подтверждённым в Resend доменом
CONTACT_FROM_EMAIL="Acme <hello@acme.com>"
# Начало темы письма
CONTACT_SUBJECT_PREFIX=Заявка с сайта
# Технический идентификатор бизнеса
FRONTSMITH_TENANT_ID=acme
# Пример ключа своего аккаунта Resend; не публикуйте рабочий ключ
RESEND_API_KEY=re_xxxxxxxxx
