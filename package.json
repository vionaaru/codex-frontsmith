{
  "name": "frontsmith",
  "version": "1.0.0",
  "description": "Цифровой фронт-офис местного бизнеса услуг для работы через Codex.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vionaaru/codex-frontsmith.git"
  },
  "homepage": "https://codex-frontsmith.example/",
  "bugs": {
    "url": "https://github.com/vionaaru/codex-frontsmith/issues"
  },
  "keywords": [
    "codex",
    "front-office",
    "local-business",
    "website",
    "customer-desk",
    "owner-approval"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "business:init": "node scripts/business-init.mjs",
    "frontsmith": "node scripts/frontsmith.mjs",
    "update:website": "node scripts/update-website.mjs",
    "owner:brief": "node scripts/prepare-owner-brief.mjs",
    "prepare:reply": "node scripts/prepare-customer-reply.mjs",
    "prepare:estimate": "node scripts/prepare-estimate-draft.mjs",
    "prepare:extension": "node scripts/prepare-extension-plan.mjs",
    "prepare:connected-action": "node scripts/prepare-connected-action-receipt.mjs",
    "first-run:status": "node scripts/first-run-readiness.mjs",
    "launch:status": "node scripts/launch-status.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "deploy:check": "node scripts/build-demo.mjs --quiet && node scripts/deploy-check.mjs",
    "preview:demo": "node scripts/preview-demo.mjs",
    "preview:website": "node scripts/preview-website.mjs",
    "office": "node scripts/office.mjs",
    "office:init": "node scripts/office.mjs init",
    "office:import": "node scripts/office.mjs import",
    "office:seed": "node scripts/office.mjs seed",
    "office:status": "node scripts/office.mjs status",
    "office:backup": "node scripts/office.mjs backup",
    "office:restore": "node scripts/office.mjs restore",
    "backups:relocate": "node scripts/backups-relocate.mjs",
    "office:serve": "node office/server.mjs",
    "test": "npm run test:launch && npm run test:regression && npm run test:office && npm run test:codex-host",
    "test:launch": "node tests/launch-readiness.mjs",
    "test:regression": "node tests/regression.mjs",
    "test:office": "node tests/office.mjs && node tests/work-reports.mjs && node tests/customers.mjs && node tests/generic-profile.mjs",
    "test:gateway-poc": "node tools/codex-gateway-poc/gateway.test.mjs",
    "test:codex-host": "node tests/codex-host.mjs",
    "test:codex-host:app-server": "node tests/codex-host-app-server.mjs",
    "test:privacy": "node services/privacy/run-tests.mjs",
    "privacy:bootstrap": "node services/privacy/bootstrap.mjs",
    "privacy:start": "node services/privacy/start.mjs",
    "ai:start": "node services/codex-host/start.mjs",
    "codex-host:login": "node services/codex-host/login.mjs",
    "smoke:codex-host": "node services/codex-host/smoke.mjs",
    "crm:bootstrap": "node services/crm/bootstrap.mjs",
    "crm:start": "node services/crm/start.mjs",
    "crm:migrate-customers": "node scripts/crm-migrate-customers.mjs",
    "test:crm": "node tests/crm-live.mjs",
    "test:first-run": "node tests/first-run.mjs",
    "smoke:crm-codex": "node services/codex-host/smoke-customer.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "better-sqlite3@12.9.0": true
  },
  "dependencies": {
    "better-sqlite3": "12.9.0"
  }
}
